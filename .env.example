# Database
DATABASE_URL=

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3d

# Frontend origin for CORS
CLIENT_URL=http://localhost:3000

# AWS
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# 이미지 주소 앞부분. 프론트가 rewrites(/api)를 거쳐 이미지 API를 부르므로 /api
API_BASE=/api

# Gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=