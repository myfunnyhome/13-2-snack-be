@baseUrl = http://localhost:3001

### 시드 계정 (비밀번호 모두 Password123!)
# superadmin@snack.com   SUPER_ADMIN
# admin@snack.com        ADMIN
# user@snack.com         GENERAL
# 회사: 스낵컴퍼니

### 1. 로그인 - 최고관리자
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{ "email": "superadmin@snack.com", "password": "Password123!" }

### 2. 내 프로필 조회 (200 예상)
# name, email, role, organization.name 네 개가 나와야 함
GET {{baseUrl}}/me

### 3. 회사명 변경 - 최고관리자 (200 예상)
# 응답 data.organization.name 이 "스낵컴퍼니2" 로 바뀌어야 함
PATCH {{baseUrl}}/me/profile
Content-Type: application/json

{ "organizationName": "스낵컴퍼니2" }

### 4. 회사명 원복 (200 예상)
PATCH {{baseUrl}}/me/profile
Content-Type: application/json

{ "organizationName": "스낵컴퍼니" }

### --- 검증 에러 ---

### 5. 변경 항목 없음 (400 예상)
# "변경할 항목이 없습니다."
PATCH {{baseUrl}}/me/profile
Content-Type: application/json

{}

### 6. 비밀번호 확인 불일치 (400 예상)
# "비밀번호가 일치하지 않습니다."
PATCH {{baseUrl}}/me/profile
Content-Type: application/json

{ "password": "newpassword123", "passwordConfirm": "wrongpassword" }

### 7. 비밀번호 8자 미만 (400 예상)
PATCH {{baseUrl}}/me/profile
Content-Type: application/json

{ "password": "short", "passwordConfirm": "short" }

### 8. 회사명 빈 문자열 (400 예상)
PATCH {{baseUrl}}/me/profile
Content-Type: application/json

{ "organizationName": "" }

### 9. body 없이 요청 (400 예상)
# Content-Type 없음. Express 5는 req.body를 undefined로 둠
PATCH {{baseUrl}}/me/profile

### --- 권한 ---

### 10. 로그인 - 관리자
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{ "email": "admin@snack.com", "password": "Password123!" }

### 11. 관리자 프로필 조회 (200 예상)
GET {{baseUrl}}/me

### 12. 관리자가 회사명 변경 시도 (403 예상)
# "회사명은 최고관리자만 변경할 수 있습니다."
PATCH {{baseUrl}}/me/profile
Content-Type: application/json

{ "organizationName": "관리자가바꾼회사명" }

### 13. 로그인 - 일반 유저
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{ "email": "user@snack.com", "password": "Password123!" }

### 14. 일반 유저 프로필 조회 (200 예상)
GET {{baseUrl}}/me

### 15. 일반 유저가 회사명 변경 시도 (403 예상)
PATCH {{baseUrl}}/me/profile
Content-Type: application/json

{ "organizationName": "일반유저가바꾼회사명" }

### --- 인증 ---

### 16. 쿠키 없이 프로필 조회 (401 예상)

# 서버가 쿠키 삭제 응답을 보내므로 클라이언트 저장소에서도 사라짐
POST {{baseUrl}}/auth/signout

###
# 저장된 쿠키를 지우고 실행
GET {{baseUrl}}/me

### 17. 쿠키 없이 프로필 수정 (401 예상)
# 저장된 쿠키를 지우고 실행
PATCH {{baseUrl}}/me/profile
Content-Type: application/json

{ "organizationName": "쿠키없음" }

### --- 아래는 비밀번호를 실제로 바꿉니다. 맨 마지막에 실행하세요 ---

### 18. 로그인 - 최고관리자
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{ "email": "superadmin@snack.com", "password": "Password123!" }

### 19. 비밀번호 변경 (200 예상)
# 실행 후 이 계정의 비밀번호는 newpassword123 이 됨
PATCH {{baseUrl}}/me/profile
Content-Type: application/json

{ "password": "newpassword123", "passwordConfirm": "newpassword123" }

### 20. 바뀐 비밀번호로 로그인 (200 예상)
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{ "email": "superadmin@snack.com", "password": "newpassword123" }

### 21. 회사명 + 비밀번호 동시 변경 (200 예상)
# 트랜잭션 확인용. 응답에 바뀐 회사명이 나와야 함
PATCH {{baseUrl}}/me/profile
Content-Type: application/json

{
  "organizationName": "스낵컴퍼니3",
  "password": "Password123!",
  "passwordConfirm": "Password123!"
}

### 22. 시드 초기화
# 위 테스트로 데이터가 바뀌었으므로 터미널에서 npm run seed 실행